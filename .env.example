# Copy to .env before running `docker compose up -d --build`.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bloodbank

# Use a long random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# Origin the browser uses to reach the frontend.
CORS_ORIGIN=http://localhost

# Seed demo hospitals, blood banks, donors and accounts when the database is empty.
SEED_ON_START=true

# Host port the frontend is published on.
FRONTEND_PORT=80
